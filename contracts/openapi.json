            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Experience": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "course_project",
              "contest",
              "club",
              "volunteer",
              "internship",
              "employment",
              "other"
            ],
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Skills"
          },
          "start_month": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Month"
          },
          "end_month": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Month"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "title"
        ],
        "title": "Experience"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecommendationRequest": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "allow_external_ai": {
            "type": "boolean",
            "title": "Allow External Ai",
            "default": false
          },
          "types": {
            "items": {
              "type": "string",
              "enum": [
                "contest",
                "competition",
                "job",
                "certification",
                "event",
                "training",
                "project",
                "notice"
              ]
            },
            "type": "array",
            "title": "Types"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 8
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile"
        ],
        "title": "RecommendationRequest"
      },
      "UserProfile": {
        "properties": {
          "age": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "school_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "School Id"
          },
          "school_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "School Name"
          },
          "education_status": {
            "type": "string",
            "enum": [
              "enrolled",
              "leave",
              "graduating",
              "graduated",
              "other",
              "unknown"
            ],
            "title": "Education Status",
            "default": "unknown"
          },
          "academic_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 8.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Year"
          },
          "major": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Major"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Interests"
          },
          "residence_region": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Residence Region"
          },
          "experience_status": {
            "type": "string",
            "enum": [
              "none",
              "provided",
              "unknown"
            ],
            "title": "Experience Status",
            "default": "unknown"
          },
          "experiences": {
            "items": {
              "$ref": "#/components/schemas/Experience"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Experiences"
          },
          "preferred_job_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Preferred Job Fields"
          },
          "preferred_job_regions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Preferred Job Regions"
          },
          "goal": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Goal"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UserProfile"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
