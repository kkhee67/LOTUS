{
  "openapi": "3.1.0",
  "info": {
    "title": "LOTUS bootstrap draft",
    "version": "4.0-draft"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
