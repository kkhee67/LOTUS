# Loaded by backend/settings.py from repository root .env.
# Import data before serving. Reads never create a missing DB; keep real/demo files separate.
DATABASE_URL=sqlite:///runtime/lotus.db
DATA_MODE=demo
CORS_ORIGINS=http://localhost:5173
# Frontend configuration belongs in frontend/.env.local; see frontend/.env.example.
# No API keys are needed. External AI is not implemented.
